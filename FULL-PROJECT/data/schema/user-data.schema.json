{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://china-made-easy.example/schema/user-data.schema.json",
  "title": "China Made Easy User Travel Data",
  "type": "object",
  "additionalProperties": false,
  "required": ["userId", "schemaVersion", "updatedAt", "trip", "cityCheckins", "attractionCheckins", "experienceCheckins", "experienceFavorites", "suggestions", "checklists"],
  "properties": {
    "userId": { "type": "string", "format": "uuid" },
    "schemaVersion": { "const": 2 },
    "updatedAt": { "type": "string", "format": "date-time" },
    "trip": { "type": ["object", "null"] },
    "cityCheckins": { "type": "array", "items": { "$ref": "#/$defs/checkin" } },
    "attractionCheckins": { "type": "array", "items": { "$ref": "#/$defs/checkin" } },
    "experienceCheckins": { "type": "array", "items": { "$ref": "#/$defs/checkin" } },
    "experienceFavorites": { "type": "array", "items": { "type": "string" } },
    "suggestions": { "type": "array", "items": { "type": "object" } },
    "checklists": { "type": "object" },
    "language": { "enum": ["en", "zh-Hans", "zh-Hant", "fr", "es", "ja", "ko"] }
  },
  "$defs": {
    "checkin": {
      "type": "object",
      "required": ["recordId", "entityId", "checkedInAt"],
      "properties": {
        "recordId": { "type": "string", "format": "uuid" },
        "entityId": { "type": "string" },
        "cityId": { "type": ["string", "null"] },
        "checkedInAt": { "type": "string", "format": "date-time" },
        "note": { "type": ["string", "null"], "maxLength": 500 }
      }
    }
  }
}
