{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://china-made-easy.example/schema/user-profile.schema.json",
  "title": "China Made Easy User Profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "createdAt", "updatedAt", "preferredLocale", "accountStatus"],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "displayName": { "type": ["string", "null"], "maxLength": 80 },
    "email": { "type": ["string", "null"], "format": "email" },
    "preferredLocale": { "enum": ["en", "zh-Hans", "zh-Hant", "fr", "es", "ja", "ko"] },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "accountStatus": { "enum": ["active", "pending-deletion", "deleted"] },
    "privacyConsentVersion": { "type": ["string", "null"] }
  }
}
